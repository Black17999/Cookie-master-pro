{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "short_name": "CookieMaster",
  "description": "__MSG_appDesc__",
  "version": "3.1.0",
  "minimum_chrome_version": "114",
  "default_locale": "zh_CN",
  "permissions": [
    "cookies",
    "tabs",
    "clipboardWrite",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "CookieMaster Pro"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
